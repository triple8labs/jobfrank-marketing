{
  "name": "01 - Email Onboarding Drip",
  "nodes": [
    {
      "id": "a1000001-0000-0000-0000-000000000001",
      "name": "Daily 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000002",
      "name": "Fetch Users by Drip Stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.JOBFRANK_URL }}/api/v1/internal/new-users",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "=Bearer {{ $env.INTERNAL_API_TOKEN }}"}
          ]
        }
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000003",
      "name": "Split Users",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [700, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000004",
      "name": "Route by Stage",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [950, 300],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json.days_since_signup }}", "rightValue": 0, "operator": {"type": "number", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "day0"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json.days_since_signup }}", "rightValue": 3, "operator": {"type": "number", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "day3"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json.days_since_signup }}", "rightValue": 10, "operator": {"type": "number", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "day10"
            },
            {
              "conditions": {
                "options": {"caseSensitive": false},
                "conditions": [{"leftValue": "={{ $json.days_since_signup }}", "rightValue": 24, "operator": {"type": "number", "operation": "equals"}}]
              },
              "renameOutput": true,
              "outputKey": "day24"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000005",
      "name": "Welcome Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1200, 100],
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "Welcome to JobFrank",
        "emailType": "html",
        "message": "<p>Hi {{ $json.name || 'there' }},</p><p>Welcome to JobFrank. Paste any job description alongside your resume and we tailor it to the role using only things you have confirmed are true.</p><p><a href='https://jobfrank.app/dashboard'>Open your dashboard</a></p><p>Any questions? Reply to this email.</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP (Mailpit / SES)"
        }
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000006",
      "name": "Tips Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1200, 250],
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "3 things that make a tailored resume actually work",
        "emailType": "html",
        "message": "<p>Hi {{ $json.name || 'there' }},</p><p>Quick tips from what we have learned building JobFrank:</p><ol><li><strong>Mirror the job description language exactly.</strong> ATS systems match keywords literally.</li><li><strong>Lead with impact, not responsibility.</strong> 'Reduced API latency by 40%' beats 'responsible for API performance'.</li><li><strong>One tailored resume beats ten generic ones.</strong> Apply to fewer roles with a stronger fit.</li></ol><p><a href='https://jobfrank.app/dashboard'>Try your next application</a>.</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP (Mailpit / SES)"
        }
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000007",
      "name": "Social Proof Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1200, 400],
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "What users are saying about JobFrank",
        "emailType": "html",
        "message": "<p>Hi {{ $json.name || 'there' }},</p><blockquote><p>'I used to spend 2 hours tailoring each resume. Now it takes 10 minutes and the output is better than what I was writing manually.'</p></blockquote><p>If you have not run your first application through yet, <a href='https://jobfrank.app/dashboard'>now is a good time</a>. It takes about 5 minutes.</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP (Mailpit / SES)"
        }
      }
    },
    {
      "id": "a1000001-0000-0000-0000-000000000008",
      "name": "Pro Upgrade Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1200, 550],
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "Unlock unlimited applications on JobFrank",
        "emailType": "html",
        "message": "<p>Hi {{ $json.name || 'there' }},</p><p>You have been using JobFrank for a few weeks. If you are actively applying, a Pro plan removes the application limit so you can move faster.</p><p><a href='https://jobfrank.app/pricing'>See Pro pricing</a></p><p>Questions? Just reply to this email.</p>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP (Mailpit / SES)"
        }
      }
    }
  ],
  "connections": {
    "Daily 8am": {
      "main": [[{"node": "Fetch Users by Drip Stage", "type": "main", "index": 0}]]
    },
    "Fetch Users by Drip Stage": {
      "main": [[{"node": "Split Users", "type": "main", "index": 0}]]
    },
    "Split Users": {
      "main": [[{"node": "Route by Stage", "type": "main", "index": 0}]]
    },
    "Route by Stage": {
      "main": [
        [{"node": "Welcome Email", "type": "main", "index": 0}],
        [{"node": "Tips Email", "type": "main", "index": 0}],
        [{"node": "Social Proof Email", "type": "main", "index": 0}],
        [{"node": "Pro Upgrade Email", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {}
}
