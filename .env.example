# PostgreSQL — n8n backend
POSTGRES_PASSWORD=changeme

# n8n
N8N_ENCRYPTION_KEY=generate-a-32-char-random-string-here
N8N_PASSWORD=changeme

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Reddit OAuth (script-type app — https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Buffer — LinkedIn scheduling (https://buffer.com/developers/api)
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=

# LinkedIn API — Share + Advertising (both approved 2026-07-07)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=             # urn:li:person:XXXX (personal) or urn:li:organization:XXXX (company page)
LINKEDIN_ACCOUNT_ID=             # numeric ad account ID from Campaign Manager
LINKEDIN_CAMPAIGN_GROUP_ID=      # leave blank to auto-create on first run
LINKEDIN_JOB_SEEKER_URN=         # urn:li:memberBehavior:XXXXX — see docs/services/linkedin-ads.md

# JobFrank app (for workflow 07 inactive user polling)
JOBFRANK_URL=http://host.docker.internal:3000
INTERNAL_API_TOKEN=           # must match INTERNAL_API_TOKEN in jobfrank .env.local

# Email — Resend SMTP (https://resend.com)
# Sign up → verify jobfrank.app domain → API Keys → create key
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...          # your Resend API key
SMTP_FROM=hello@jobfrank.app
ALERT_EMAIL=triple8labs@gmail.com
